# Server
PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=*
REQUEST_TIMEOUT_MS=15000
CACHE_TTL_MS=120000

# Optional: existing Lampac-compatible server. If set, adapters proxy /lite/<source> to it.
# LAMPAC_BASE_URL=https://your-lampac.example

# VideoHUB (the API discovered in Lampac's public adapter)
VIDEOHUB_API_BASE=https://plapi.cdnvideohub.com
VIDEOHUB_REFERER=https://hdkino.pub/

# VeoVeo
VEO_API_BASE=https://api.rstprgapipt.com
# Optional catalog JSON used for title/ID lookup. The file must be a JSON array.
VEO_CATALOG_URL=

# HDVB: both values are deployment-specific and must be supplied by the operator.
HDVB_API_BASE=
HDVB_VIDEO_BASE=
HDVB_API_TOKEN=
HDVB_REFERER=

# Vibix: the public API shape can change, so keep the endpoint configurable.
# It must accept the query parameters sent by this backend and return a JSON object.
VIBIX_API_URL_TEMPLATE=
VIBIX_REFERER=https://vibix.org/

# Optional basic protection for the backend itself.
BACKEND_TOKEN=
